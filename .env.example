# Firebase Admin SDK (Server uses this)
# Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Firebase Web Config (Frontend uses this)
# Get these values from Firebase Console → Project Settings → General → Your Apps
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Application Settings
SECRET_KEY=your_secret_key

# Base URL used to build links in outbound emails (reminders, confirmations).
# Defaults to https://alphabook.uk if unset.
APP_BASE_URL=https://alphabook.uk

# Outbound email (SMTP) — application confirmations and admin reminders.
# Any SMTP account works: Gmail with an app password, Oxford's own SMTP, or a
# transactional-email provider's SMTP endpoint. Leave SMTP_HOST unset to
# disable outbound email (it will log instead of sending — useful for local
# dev and CI).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@alphabook.uk
SMTP_FROM_NAME=AlphaBook
# false only for an implicit-TLS relay on port 465
SMTP_USE_STARTTLS=true
# Access passwords. There are deliberately NO defaults in the code (this repo
# is public, so a default would be a password anyone can read). Leave one
# unset and that door is simply closed.
ADMIN_PASSWORD=           # direct admin login from the normal login page
ADMIN_USERNAME=admin
ANALYST_PASSWORD=         # self-selecting Quant/Fundamental Analyst on the profile
BOOTCAMP_PASSWORD=        # self-selecting Quant/Fundamental Bootcamp on the profile
INTERVIEW_OA_PASSWORD=    # the interview online assessment access code

# Google connection for oxfordalphafund@gmail.com — mints Google Meet links for
# interviews, and sends the site's email as that address (SMTP above becomes
# the fallback). Obtain the refresh token once with scripts/gcal_oauth_setup.py.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_ACCOUNT_EMAIL=oxfordalphafund@gmail.com
